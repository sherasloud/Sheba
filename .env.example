# Supabase Configuration (REQUIRED for account creation)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# SSL Wireless Configuration for Real Recharge
SSL_WIRELESS_API_URL=https://api.sslwireless.com
SSL_WIRELESS_STORE_ID=your_store_id_here
SSL_WIRELESS_STORE_PASSWORD=your_store_password_here
SSL_WIRELESS_API_KEY=your_api_key_here

# Environment
NODE_ENV=production

# Database (Optional - for transaction logging)
DATABASE_URL=your_database_url_here

# Notification Settings
ENABLE_SMS_NOTIFICATIONS=true
SMS_API_KEY=your_sms_api_key_here

# SMS Gateway Configuration for Sheba branded messages
SMS_GATEWAY_URL=https://api.sms.net.bd/sendsms
SMS_API_KEY=your_sms_gateway_api_key_here
SHEBA_SENDER_ID=SHEBA
